{
  "name": "bluslate",
  "private": true,
  "type": "module",
  "description": "BluSlate: test a business idea through seven pillars and a simulated market.",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @bluslate/web dev",
    "build": "pnpm --filter @bluslate/web build",
    "start": "pnpm --filter @bluslate/web start",
    "worker": "pnpm --filter @bluslate/worker start",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "node scripts/eval.mjs",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "docs:readme": "node scripts/sync-readme.mjs",
    "admin:password": "node scripts/hash-password.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "dotenv": "18.0.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
