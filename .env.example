# Copy to apps/web/.env.local and fill in. Never commit real values.

# Database — the docker-compose Postgres in development; Neon in production.
DATABASE_URL=postgresql://bluslate:bluslate@localhost:5432/bluslate

# Auth.js — a long random string. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Public site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sign-in emails (Resend). Leave empty in development: magic links are then
# printed in the terminal and written to .dev-mail/ instead of being emailed.
AUTH_RESEND_KEY=
# Sender for sign-in emails, on a domain verified in Resend, e.g. BluSlate <signin@your-domain>
EMAIL_FROM=

# AI (used from S3). The app's own Anthropic key — separate from your Claude Code sign-in.
ANTHROPIC_API_KEY=
AI_MODEL_TOP=claude-opus-5-5
AI_MODEL_STANDARD=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
AI_DAILY_COST_CAP_USD=

# File storage (used from S3).
STORAGE_DRIVER=local
STORAGE_BUCKET=
